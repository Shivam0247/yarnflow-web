{
  "name": "yarnflow",
  "private": true,
  "version": "1.0.0",
  "description": "YarnFlow \u2014 yarn trading ERP (sales, purchase, stock, accounts, GST) for Shree Umiya Yarn Pvt Ltd",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev -w server\" \"npm:dev -w web\"",
    "build": "npm run build -w server && npm run build -w web",
    "start": "npm run start -w server",
    "test": "npm test -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:deploy": "npm run db:deploy -w server",
    "db:seed": "npm run db:seed -w server",
    "db:reset": "npm run db:reset -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "sync-design": "node tools/dc2react.mjs design/project web/src"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "engines": {
    "node": ">=20"
  }
}
