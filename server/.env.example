# PostgreSQL connection
DATABASE_URL=postgres://yarnflow:yarnflow@localhost:5432/yarnflow
# Used only by `npm test` (the suite wipes and re-creates this database)
TEST_DATABASE_URL=postgres://yarnflow:yarnflow@localhost:5432/yarnflow_test
# Change this in production (any long random string)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
PORT=4000
# Frontend origin allowed to call the API (comma separated)
CORS_ORIGIN=http://localhost:5173
